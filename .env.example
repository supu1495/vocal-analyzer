# ============================================================================
# 環境変数のテンプレート
#
# 作り方（新しく環境を作るとき）:
#   python3 scripts/gen_secrets.py > .env
#   → 秘密情報（SECRET_KEY / POSTGRES_PASSWORD / REDIS_PASSWORD）がランダムな値で埋まる
#   → そのあと TUNNEL_TOKEN と CORS_ALLOWED_ORIGINS を手で書く
#   ※ 既存の .env があるときに実行すると上書きされるので注意
#
# 下の初期値（changeme / your-secret-key-here）のままや短すぎる値では、
# backend と celery_worker が理由をログに出して起動を止める（backend/secret_check.py）
#
# 値は 0-9a-f だけで作ること（gen_secrets.py はそうしている）。
# DATABASE_URL / REDIS_URL に埋め込むため、/ + = @ などが入ると URL として読めなくなる
# ============================================================================

# ── Database ────────────────────────────────────────────────────────────────
# DATABASE_URL は docker-compose.yml の中でこの 3 つから組み立てる
POSTGRES_USER=postgres
POSTGRES_DB=vocal_analyzer

# PostgreSQL のパスワード（16文字以上）
# 変更手順: .env を書き換えるだけでは変わらない。postgres は volume が空の初回起動時しか
#           POSTGRES_PASSWORD を読まないため、DB 側も ALTER する必要がある
#   1. 新しい値を作る:  python3 scripts/gen_secrets.py POSTGRES_PASSWORD
#   2. DB 側を先に変える（パスワードを2回聞かれるので 1 の値を貼る）:
#        docker compose exec db psql -U postgres -d vocal_analyzer -c '\password postgres'
#      ※ 要確認: この手順はまだ実際には試していない
#   3. .env の POSTGRES_PASSWORD を 1 の値に書き換える
#   4. docker compose up -d   （backend / celery_worker が新しい値で作り直される）
POSTGRES_PASSWORD=changeme

# ── Redis ───────────────────────────────────────────────────────────────────
# Redis のパスワード（16文字以上）。ロックアウトの回数と Celery のタスクキューを守る
# REDIS_URL は docker-compose.yml の中でこの値から組み立てる
# 変更手順:
#   1. sed -i "s/^REDIS_PASSWORD=.*/$(python3 scripts/gen_secrets.py REDIS_PASSWORD)/" .env
#   2. docker compose up -d   （redis / backend / celery_worker が作り直される）
#   作り直しの数秒間はログインと分析の受付が止まるので、分析中でないときに行う
REDIS_PASSWORD=changeme

# ── JWT ─────────────────────────────────────────────────────────────────────
# ログイン Cookie の JWT に署名する鍵（32文字以上。HS256 は 256bit 以上が推奨: RFC 7518 §3.2）
# 変更手順:
#   1. sed -i "s/^SECRET_KEY=.*/$(python3 scripts/gen_secrets.py SECRET_KEY)/" .env
#   2. docker compose up -d
#   変えるとログイン中の全員がログアウトされる（古い鍵で署名した JWT が通らなくなるため）
#   鍵が漏れた・画面に出たときは、すぐに変えること
SECRET_KEY=your-secret-key-here

# ── CORS ────────────────────────────────────────────────────────────────────
# ブラウザからの API 呼び出しを許可するオリジン（カンマ区切り）
# 本番例: CORS_ALLOWED_ORIGINS=http://localhost:5173,https://vocal-analyzer.supu361.dev
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Cloudflare Tunnel ───────────────────────────────────────────────────────
# cloudflared サービスがトンネルに接続するためのトークン（本番のみ。ローカルだけなら空で良い）
# Cloudflare Zero Trust ダッシュボードのトンネル設定画面から取得する
# 変更手順: ダッシュボードでトークンを作り直し → .env を書き換え → docker compose up -d
TUNNEL_TOKEN=

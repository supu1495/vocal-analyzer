# Database
# POSTGRES_PASSWORD は openssl rand -base64 32 などで強いランダム値を生成すること
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vocal_analyzer
# DATABASE_URL は docker-compose.yml の中で上の 3 つから組み立てられるので個別に書く必要はない

# Redis
REDIS_URL=redis://redis:6379

# JWT
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
DEBUG=true

# CORS 許可オリジン（カンマ区切り。未設定の場合は http://localhost:5173 がデフォルト）
# 本番例: CORS_ALLOWED_ORIGINS=https://vocal-analyzer.supu361.dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
